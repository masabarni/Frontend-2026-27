<Window x:Class="WpfApp8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp8"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="Új Dolgozó Hozzáadása" Click="AddEmployee_Click" Margin="10"/>
        
        <!-- Data Grid -->
        <DataGrid Name="dataGrid" Grid.Row="1" Margin="10" ItemsSource="{Binding Employees}" AutoGenerateColumns="False" CanUserAddRows="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Név" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Pozíció" Binding="{Binding Position}" Width="150"/>
                <DataGridTextColumn Header="Fizetés" Binding="{Binding Salary}" Width="150"/>
                <DataGridTextColumn Header="Házas" Binding="{Binding Married}" Width="150"/>
                <DataGridTemplateColumn Header="Műveletek" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✏️" Width="30" Margin="2" Click="Employee_Edit"/>
                                <Button Content="🗑️" Width="30" Margin="2" Click="Employee_Delete"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
         
        <!-- ListView GridView-val -->
        <ListView Grid.Row="2" Margin="10" ItemsSource="{Binding Employees}">
            <ListView.View>
            <GridView>
                <GridViewColumn Header="Név" DisplayMemberBinding="{Binding Name}" Width="150"/>
                <GridViewColumn Header="Pozíció" DisplayMemberBinding="{Binding Position}" Width="150"/>
                <GridViewColumn Header="Fizetés" DisplayMemberBinding="{Binding Salary}" Width="150"/>
                    <GridViewColumn Header="Házas" DisplayMemberBinding="{Binding Married}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
