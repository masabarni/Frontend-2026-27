<Window x:Class="WpfApp8.DataInput"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp8"
        mc:Ignorable="d"
        Title="DataInput" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="184"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Content="Új Dolgozó Bevitele" HorizontalAlignment="Center" Margin="0,33,0,0" VerticalAlignment="Top" Height="45" Width="176" FontSize="18" FontStyle="Italic" FontWeight="Bold" Grid.Column="1"/>
        <Label Grid.Row="1" Content="Név:" HorizontalContentAlignment="Left" Margin="92,14,11,24" FontSize="20" FontWeight="Bold"/>
        <TextBox Name="UserName" Grid.Column="1" HorizontalAlignment="Left" Margin="26,21,0,24" Grid.Row="1" Width="237"/>
        <TextBox Name="Pozi" Grid.Column="1" HorizontalAlignment="Left" Margin="26,23,0,22" Grid.Row="2" Width="237"/>
        <TextBox Name="fizu" Grid.Column="1" HorizontalAlignment="Left" Margin="26,23,0,22" Grid.Row="3" Width="237"/>
        <Label Grid.Row="2" Content="Pozició:" HorizontalContentAlignment="Left" Margin="92,25,11,10" FontSize="20" FontWeight="Bold"/>
        <Label Grid.Row="3" Content="Fizetés:" HorizontalContentAlignment="Left" Margin="93,26,0,10" FontSize="20" FontWeight="Bold"/>
        <StackPanel Grid.Column="1" Grid.Row="4" Orientation="Horizontal" Margin="0,89,0,0" Grid.RowSpan="2">
            <Button Content="Bevitel" Margin="10" Width="179" Click="Button_Click"/>
            <Button Content="Mégse" Margin="10" Width="179" Click="Button_Click_1"/>
        </StackPanel>
        <Label Grid.Row="4" Content="Házas:" HorizontalContentAlignment="Left" Margin="93,18,0,18" FontSize="20" FontWeight="Bold"/>
        <CheckBox Name="hazas" Grid.Row="4" Checked="CheckBox_Checked" Margin="26,31,537,18" Grid.Column="1" IsChecked="False"/>
    </Grid>
</Window>
